    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>XAppGroup</AssemblyName>
    <RootNamespace>XAppGroup</RootNamespace>
    <Version>1.2.0</Version>
    <ApplicationIcon>XAppGroup.ico</ApplicationIcon>
  </PropertyGroup>
</Project>

